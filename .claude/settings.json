{
  "permissions": {
    "allow": [
      "mcp__uchet__whoami",
      "mcp__uchet__help",
      "mcp__uchet__describe",
      "mcp__uchet__find",
      "mcp__uchet__get",
      "Bash(git status*)",
      "Bash(git pull*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git switch *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && if [ \"$(git branch --show-current)\" = main ]; then git pull --ff-only --quiet 2>&1 || echo 'ВНИМАНИЕ: правила не обновились из GitHub — сообщи Роберту'; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": true
  }
}
